---
import Layout from '../../layouts/Layout.astro';
import { projects, clusters, projectUrl, type Project } from '../../data/projects';
import ObstacleResolution from '../../components/ObstacleResolution.astro';
import EvidenceLab from '../../components/EvidenceLab.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import SpecChart from '../../components/SpecChart.astro';
import MetricEvidence from '../../components/MetricEvidence.astro';
import ChainExplorer from '../../components/ChainExplorer.astro';
import DigitalEvidence from '../../components/DigitalEvidence.astro';
import C3C4Evidence from '../../components/C3C4Evidence.astro';
import ReasoningChain from '../../components/ReasoningChain.astro';
import ProjectVisuals from '../../components/ProjectVisuals.astro';
import { mixueVisuals } from '../../data/mixue-visuals';
import { industryVisuals } from '../../data/industry-visuals';

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}
const { project: p } = Astro.props as { project: Project };
const index = projects.findIndex(project => project.slug === p.slug);
const previous = projects[(index - 1 + projects.length) % projects.length];
const next = projects[(index + 1) % projects.length];
const isESG = p.slug === 'esg-evidence';
const isGreen = p.slug === 'green-finance';
const isIndustry = p.slug === 'industry-research';
const isDigital = p.slug === 'digital-finance';
const isC3C4 = p.slug === 'c3c4-materials';
const visualItems = isESG ? [{
  src:'assets/esg/evidence-research.png', title:'从文本，到结构，再到验证',
  caption:'原创生成的方法插画：定位披露问题，拆解主体、行动与依据，再交由人工校准。图中展示研究思路，具体实验状态见下方记录。',
  source:'依据本项目研究流程设计，使用图像生成工具制作；不含企业观测或实测结果。',kind:'生成方法示意'
}] : p.slug === 'mixue' ? mixueVisuals.map(item => ({...item,source:`${item.source}；${item.sourcePage}`})) : (industryVisuals[p.slug] || []).map(item => ({...item,kind:({original:'原材料局部图',redrawn:'真实数据重绘',concept:'原创方法示意'} as Record<string,string>)[item.kind],source:`${item.source}；${item.locator}`}));
const interactiveTitle = isESG ? '从一句话，观察证据结构' : isGreen ? '切换规格，检查结论' : isIndustry ? '从工艺到经营变量' : isDigital ? '分别查看四个报告系数' : '沿着变量链展开';
const chainVariant: Record<string, string> = { 'industry-research': 'c3c4', 'c3c4-materials': 'c3c4', 'methionine': 'methionine', 'biodiesel': 'fuels', 'polyester-roadshow': 'polyester', 'dogecoin': 'narrative', 'mixue': 'business' };
const figures = [
  {n:1, title:'SDID 估计与置换参照分布',caption:'产业结构指标的实际 SDID 估计置于 165 种地州标签分配中比较；经验分位数帮助理解参照位置。'},
  {n:2, title:'生产性服务业就业：占比、人数与共同样本',caption:'占比、人数与对数对应不同结果口径；全国补充样本与新疆三试点分别解释。'},
  {n:3, title:'新疆 11 地州的年度估计',caption:'2016 年为省略基期，2017 年为部分实施年。政策前完整污染物观测年份较少，95% 城市聚类区间仅作辅助。'},
  {n:4, title:'按估计值排序的置换参照分布',caption:'实际组合为哈密、昌吉、克拉玛依；分布中的极端位置不能消除资源能源地区选址的非随机性。'},
  {n:5, title:'燃烧相关污染指数的规格敏感性',caption:'并列基准、城市趋势、完整观测、资源暴露与 37 城规格；趋势设定改变统计支持，估计样本与置换空间分别列明。'}
];
---
<Layout title={`${p.title} · 唐露宁`} description={p.description} current="work">
  <header class="case-header wrap">
    <div class="breadcrumb"><a href={import.meta.env.BASE_URL}>首页</a><span>/</span><a href={`${import.meta.env.BASE_URL}#work`}>研究与项目</a><span>/</span><span>{p.number}</span></div>
    <div class="eyebrow mono">项目 {p.number} / {p.category}</div>
    <h1>{p.title}</h1>
    <p class="case-description">{p.description}</p>
    <div class="case-meta"><div>我的角色<strong>{p.role}</strong></div><div>时间<strong>{p.date}</strong></div><div>项目状态<strong>{p.status}</strong></div></div>
    <div class="tag-row" style="margin-top:22px">{p.tags.map(tag => <span>{tag}</span>)}</div>
  </header>
  <div class="case-layout wrap">
    <nav class="case-nav" aria-label="本页目录"><span class="small-label">本页导览</span><a href="#question">01 · 研究问题</a><a href="#journey">02 · 研究路径</a>{visualItems.length > 0 && <a href="#project-visuals">图像与分析</a>}<a href="#evidence">03 · 交互与证据</a>{isC3C4 && <a href="#report-charts">报告图表</a>}{isGreen && <a href="#paper-figures">论文原图</a>}<a href="#method">04 · 方法与发现</a><a href="#contribution">05 · 我的贡献</a><a href="#obstacles">06 · 遇到的问题</a><a href="#sources">07 · 材料来源</a></nav>
    <article class="case-content">
      <section class="case-section" id="question"><h2>先把问题问清楚</h2><blockquote class="question-callout">{p.question}</blockquote><p class="takeaway">{p.takeaway}</p></section>
      <section class="case-section" id="journey"><h2>研究如何一步步展开</h2><ReasoningChain slug={p.slug} /></section>
      {visualItems.length > 0 && <section class="case-section" id="project-visuals"><h2>让分析过程看得见</h2><ProjectVisuals items={visualItems} /></section>}
      <section class="case-section" id="evidence">
        <h2>{interactiveTitle}</h2>
        {isESG ? <>
          <EvidenceLab />
          <p class="source-note">示意台用于解释分类边界。三个例句由人工编写；不代表模型现场推断，也不构成真实企业表现判断。</p>
          <h3 style="margin-top:32px">历史分类基线：两种评价口径</h3><MetricEvidence />
          <div class="method-result" style="margin-top:25px"><div><h3>已完成的本地合成测试</h3><ul><li>5 份合成场景，28 次分阶段请求。</li><li>关系抽取阶段三次请求中 2 次完成；存在截断与关系冲突。</li><li>完整结构规范投影通过 0/5。</li></ul></div><div><h3>下一阶段的验证问题</h3><ul><li>强模型合成测试尚未运行。</li><li>真实研究语料抽取尚未运行。</li><li>人工语义校准与构念检验待完成。</li></ul></div></div>
          <p class="source-note">实验事实截至 2026-10-17。历史分类结果与新版结构化抽取分别评价；结构合法、完整投影和语义正确性是三层检查。</p>
        </> : isGreen ? <><SpecChart /><p>这组交互展示同一研究结论对样本与趋势假设的敏感性。点估计方向相近；加入城市趋势后，区间覆盖零，置换 p 也随之变化。</p></> : isDigital ? <DigitalEvidence /> : <ChainExplorer variant={chainVariant[p.slug]} />}
      </section>
      {isC3C4 && <section class="case-section" id="report-charts"><h2>从产业链，回到报告中的图表</h2><p>将报告中的产品结构、产能产量与工艺差异放在一起阅读。图表保留原资料年份，支持查看数据、切换指标和放大原图。</p><C3C4Evidence /></section>}
      <section class="case-section" id="method"><h2>方法与发现，分别说明</h2><div class="method-result"><div><h3>我如何做</h3><ul>{p.methods.map(method => <li>{method}</li>)}</ul></div><div><h3>证据告诉了什么</h3><ul>{p.findings.map(finding => <li>{finding}</li>)}</ul></div></div></section>
      {isGreen && <section class="case-section" id="paper-figures"><h2>回到原始论文图</h2><p>以下五张图来自本人工作论文第七稿。点击图像可放大，保留图中的结果口径与方法说明。</p>{figures.map(figure => <EvidenceFigure {...figure} />)}</section>}
      {isIndustry && <section class="case-section" id="industry-topics"><h2>继续走进一个专题</h2><div class="case-clusters">{clusters.map(topic => <a href={projectUrl(topic.slug)}><h3>{topic.title} <span aria-hidden="true">↗</span></h3><p>{topic.description}</p><small>{topic.date} · {topic.status}</small></a>)}</div></section>}
      <section class="case-section" id="contribution"><h2>我具体负责什么</h2><ul class="content-list">{p.contribution.map(item => <li>{item}</li>)}</ul></section>
      <section class="case-section" id="obstacles"><h2>真正需要解决的问题</h2><ObstacleResolution items={p.obstacles} /></section>
      <section class="case-section" id="sources"><h2>让判断可以追溯</h2><div class="source-list">{p.sources.map(source => <div><div><strong>{source.title}</strong><p>{source.locator}</p></div><small>{source.kind}</small></div>)}</div><p class="source-note">网页对个人贡献与参考资料分别说明。选取的局部图、数据重绘和方法示意逐项标注来源；完整原稿与工作底稿保留本地。</p></section>
      <nav class="project-next" aria-label="相邻项目"><a href={projectUrl(previous.slug)}><small>← 上一个项目</small>{previous.title}</a><a href={projectUrl(next.slug)}><small>下一个项目 →</small>{next.title}</a></nav>
    </article>
  </div>
</Layout>
