---
import Layout from '../layouts/Layout.astro';
import Atlas from '../components/Atlas.astro';
import EvidenceLab from '../components/EvidenceLab.astro';
import { featured, clusters, additional, projectUrl } from '../data/projects';
const base=import.meta.env.BASE_URL;
---
<Layout>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy"><div class="eyebrow"><span class="tiny-line"></span> 以金融为起点，在实践中研究。</div><h1 id="hero-title">把复杂问题，<br/>变成<span class="serif-em">可验证</span><br/>的答案<span class="title-period">。</span></h1><p class="hero-description">我是唐露宁，中央民族大学金融学本科生。<br/>关注 AI 如何理解文本、组织证据，<br class="mobile-hide"/>以及支持真实的研究与决策。</p><div class="hero-cta"><a class="button primary" href="#work">探索我的项目 <span>↗</span></a><button class="text-button" data-tour="#lab">从一个交互示例开始 <span>↓</span></button></div><div class="availability"><span class="status-dot"></span> 寻找日常实习 <span class="availability-line"></span><span>AI 产品 / 研究</span></div></div>
    <Atlas />
    <div class="hero-bottom"><span class="mono">中国 · 2028 届本科生</span><span>问题 → 数据 → 方法 → 证据</span><a href="#work" aria-label="向下查看项目">向下探索 <span>↓</span></a></div>
  </section>
  <section class="work-section wrap" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="eyebrow">01 / 精选项目</span><h2 id="work-title">研究，落在具体的问题里。</h2></div><a class="section-aside inline-link" href={`${base}projects/`}>查看全部项目 →</a></div>
    <div class="featured-grid">
      <a class="featured-main" href={projectUrl(featured[0].slug)}><div class="project-meta"><span>01 / AI × 文本测量</span><span class="arrow-circle">↗</span></div><div class="mini-evidence" aria-hidden="true"><div class="paper-sheet"><span class="mono">企业年报 → 结构化证据</span><div class="fake-text-line w70"></div><div class="fake-text-line"></div><div class="fake-text-line w80"></div><div class="token-row"><span>命题</span><i></i><span>属性</span><i></i><span>关系</span></div><div class="evidence-anchor"><span>↳</span> 原文引用 · 状态 · 时间 · 范围</div><div class="sheet-bottom"><span>让证据始终可追溯</span><span>↗</span></div></div><span class="visual-index">01</span></div><div class="featured-content"><div class="tag-row"><span>NLP</span><span>模型评估</span><span>证据设计</span></div><h3>让 ESG 披露<br/>成为可追溯的证据</h3><p>{featured[0].description}</p><div class="project-bottom"><span>独立研究 · 持续迭代</span><span>查看完整项目 ↗</span></div></div></a>
      <div class="featured-stack"><a class="featured-small policy-card" href={projectUrl(featured[1].slug)}><div class="project-meta"><span>02 / 政策 × 证据</span><span class="arrow-circle">↗</span></div><div class="policy-mini" aria-hidden="true"><span class="mini-axis"></span><span class="mini-range range-one"></span><span class="mini-range range-two"></span><span class="mini-label">基准设定</span><span class="mini-label second">+ 城市趋势</span><span class="mini-caption">来自七稿真实估计 · 详见项目</span></div><h3>绿色金融试点之后，<br/>发生了什么？</h3><p>用比较、趋势与置换检验，判断证据支持多远。</p><div class="project-bottom"><span>DID / SDID · 工作论文七稿</span><span>查看项目 ↗</span></div></a><a class="featured-small industry-card" href={projectUrl(featured[2].slug)}><div class="project-meta"><span>03 / 产业 × 基本面</span><span class="arrow-circle">↗</span></div><div class="chain-mini" aria-hidden="true"><span>原料</span><i>→</i><span>工艺</span><i>→</i><span>产品</span><i>→</i><span>需求</span></div><h3>沿着产业链，<br/>找到关键变量</h3><p>从化工行研实习，理解领域知识如何进入研究。</p><div class="project-bottom"><span>长城证券 · 4 个专题</span><span>查看项目 ↗</span></div></a></div>
    </div>
    <div class="cluster-row"><span class="small-label">行业专题索引</span>{clusters.map(p=><a href={projectUrl(p.slug)}>{p.slug==='c3c4-materials'?'C3/C4 与新材料':p.slug==='polyester-roadshow'?'长丝 × 路演':p.title.split('：')[0]}<span>↗</span></a>)}</div>
  </section>
  <section class="lab-section" id="lab" tabindex="-1" aria-labelledby="lab-title"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">02 / 交互实验</span><h2 id="lab-title">一句话里，有多少种证据？</h2></div><span class="section-aside">切换表述，观察证据结构的变化。</span></div><EvidenceLab /><div class="lab-footnote"><p>这是当前研究的一小段：将承诺、行动与结果分开，再保留能回到原文的属性。</p><a class="inline-link" href={projectUrl('esg-evidence')}>阅读方法与真实测试进展 ↗</a></div></div></section>
  <section class="other-work wrap" aria-labelledby="other-title"><div class="section-heading"><div><span class="eyebrow">03 / 更多研究问题</span><h2 id="other-title">也从这些问题出发。</h2></div><span class="section-aside">团队研究与商业案例</span></div><div class="additional-list">{additional.map((p,i)=><a href={projectUrl(p.slug)}><span class="mono">0{i+1}</span><div><h3>{p.title}</h3><p>{p.description}</p></div><span class="list-category">{p.category}</span><span class="list-arrow">↗</span></a>)}</div></section>
  <section class="about-section wrap" id="about" aria-labelledby="about-title"><div class="about-intro"><span class="eyebrow">04 / 关于我</span><h2 id="about-title">从金融出发，<br/>走向 AI 与研究。</h2><p>做研究的过程，让我反复练习三件事：<br/>把问题定义清楚，把数据处理扎实，<br/>把结果解释准确。</p><a class="inline-link" href={`${base}profile/`}>查看简历摘要 ↗</a></div><div class="about-details"><div class="experience-line"><span class="mono">2026.04 — 09</span><div><h3>长城证券</h3><p>化工行业研究实习生</p><small>滨化股份 C3/C4 与新材料板块 · 公司研究 · 数据核验</small></div></div><div class="experience-line"><span class="mono">2024 — 2028</span><div><h3>中央民族大学</h3><p>金融学 · 本科在读</p><small>均分 90.65 / 100 · 专业排名 5 / 59</small></div></div><div class="skill-groups"><div><h4>已实践</h4><p>Python · Stata · Excel · iFinD<br/>文本处理 · 面板分析 · 研究可视化</p></div><div><h4>探索中</h4><p>结构化抽取 · 模型评测<br/>AI 产品中的证据与验证流程</p></div></div><div class="language-line">雅思 6.5 <span>·</span> 大学英语六级 520</div></div></section>
  <section class="contact-section" id="contact"><div class="wrap"><div><span class="eyebrow">从一个好问题开始合作。</span><h2>一起，把问题往前推进。</h2><p>期待 AI 产品与研究方向的日常实习机会。</p></div><div class="contact-actions"><a href="mailto:481200839@qq.com">481200839@qq.com <span>↗</span></a><button data-copy-mail class="text-button">复制邮箱 <span>⧉</span></button></div></div></section>
</Layout>
