---
const base=import.meta.env.BASE_URL;
---
<div class="atlas" data-atlas>
  <div class="atlas-heading"><span class="mono">研究地图</span><span>01 — 03</span></div>
  <div class="atlas-tabs" role="group" aria-label="探索研究方向"><button data-atlas-view="text" aria-pressed="true">文本测量</button><button data-atlas-view="policy" aria-pressed="false">政策评估</button><button data-atlas-view="industry" aria-pressed="false">产业研究</button></div>
  <div class="atlas-map"><svg viewBox="0 0 500 305" role="img" aria-labelledby="atlas-title"><title id="atlas-title">研究工作流概念图：从原始信息到可追溯的证据</title><defs><pattern id="dotgrid" x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".8" fill="#b8c8b9" opacity=".18"/></pattern></defs><rect width="500" height="305" fill="url(#dotgrid)"/><circle class="orbit" cx="250" cy="155" r="100"/><circle class="orbit" cx="250" cy="155" r="140"/><path class="atlas-connection" d="M100 107 250 155 393 83M100 107 112 250 250 155 389 241 393 83M250 155 250 35"/><g class="map-node"><circle cx="100" cy="107" r="29"/><text x="100" y="111" data-node="a">原文</text></g><g class="map-node"><circle cx="393" cy="83" r="26"/><text x="393" y="87" data-node="b">属性</text></g><g class="map-node"><circle cx="112" cy="250" r="26"/><text x="112" y="254" data-node="c">标注</text></g><g class="map-node"><circle cx="389" cy="241" r="29"/><text x="389" y="245" data-node="d">验证</text></g><g class="center-node"><circle cx="250" cy="155" r="51"/><circle cx="250" cy="155" r="60" fill="none" stroke="#c5b58c" stroke-opacity=".35"/><text x="250" y="152" data-node="center">命题</text><text class="node-en" x="250" y="171" data-node="sub">证据命题</text></g><circle cx="250" cy="35" r="4" fill="#cfba8e"/><text class="map-caption" x="250" y="294">概念结构图 · 点击上方切换研究方向</text></svg><span class="atlas-corner mono">联系语境<br/>检查证据</span></div>
  <a class="atlas-detail" href={`${base}projects/esg-evidence/`} data-atlas-link><div><small data-atlas-label>01 / AI × 文本测量</small><strong data-atlas-title>从一段披露，到一个证据单元</strong><p data-atlas-description>保留类型、状态与原文位置，让每次解释有据可查。</p></div><span aria-hidden="true">↗</span></a>
</div>
<script>
  const atlas=document.querySelector<HTMLElement>('[data-atlas]');
  if(atlas){const views={text:{nodes:['原文','属性','标注','验证','命题','证据命题'],label:'01 / AI × 文本测量',title:'从一段披露，到一个证据单元',desc:'保留类型、状态与原文位置，让每次解释有据可查。',slug:'esg-evidence'},policy:{nodes:['样本','趋势','比较','置换','识别','识别设计'],label:'02 / 政策 × 因果推断',title:'让结论，接受不同设定的检验',desc:'11 个地州、3 个试点，检视趋势与非随机选址。',slug:'green-finance'},industry:{nodes:['原料','工艺','供需','价差','产业链','价值传导'],label:'03 / 产业 × 基本面',title:'沿着产业链，找到关键变量',desc:'把原料、工艺、需求与利润放进同一幅研究图景。',slug:'industry-research'}};atlas.querySelectorAll<HTMLButtonElement>('[data-atlas-view]').forEach(b=>b.addEventListener('click',()=>{const v=views[b.dataset.atlasView as keyof typeof views];atlas.querySelectorAll('[data-atlas-view]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));['a','b','c','d','center','sub'].forEach((k,i)=>atlas.querySelector(`[data-node="${k}"]`)!.textContent=v.nodes[i]);atlas.querySelector('[data-atlas-label]')!.textContent=v.label;atlas.querySelector('[data-atlas-title]')!.textContent=v.title;atlas.querySelector('[data-atlas-description]')!.textContent=v.desc;atlas.querySelector<HTMLAnchorElement>('[data-atlas-link]')!.href=`${import.meta.env.BASE_URL}projects/${v.slug}/`;}));}
</script>
