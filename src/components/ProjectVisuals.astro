---
export interface ProjectVisual {
  src: string;
  title: string;
  caption: string;
  source?: string;
  kind?: string;
  alt?: string;
  width?: number;
  height?: number;
  notes?: string[];
  links?: {label:string;url:string}[];
  data?: {label:string;value:number}[];
  unit?: string;
}
interface Props { items: ProjectVisual[]; title?: string; description?: string }
const { items, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const assetUrl = (src: string) => {
  if (/^https?:\/\//i.test(src)) return src;
  if (base !== '/' && src.startsWith(base)) return src;
  return `${base}${src.replace(/^\/+/, '')}`;
};
---

{items.length > 0 && <div class="project-visuals">
  {(title || description) && <header class="project-visuals-heading">{title && <h3>{title}</h3>}{description && <p>{description}</p>}</header>}
  <div class:list={['project-visuals-grid', { 'is-single': items.length === 1 }]}>
    {items.map(item => <figure class="project-visual">
      <button type="button" data-figure={assetUrl(item.src)} data-caption={item.title} aria-label={`放大查看：${item.title}`}><img src={assetUrl(item.src)} alt={item.alt || item.title} width={item.width} height={item.height} loading="lazy" decoding="async" /><span class="project-visual-zoom">放大查看 ↗</span></button>
      <figcaption><div class="project-visual-title"><h4>{item.title}</h4>{item.kind && <span>{item.kind}</span>}</div><p>{item.caption}</p>{item.source && <small>来源：{item.source}</small>}
        {(item.data?.length || item.notes?.length || item.links?.length) && <details class="visual-data"><summary>查看数据与口径</summary>
          {item.data?.length && <table><caption>图中原始数值{item.unit ? `（${item.unit}）` : ''}</caption><thead><tr><th scope="col">年份 / 地区</th><th scope="col">数值</th></tr></thead><tbody>{item.data.map(row => <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table>}
          {item.notes?.map(note => <p>{note}</p>)}
          {item.links?.map(link => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}
        </details>}
      </figcaption>
    </figure>)}
  </div>
</div>}

<style>
  .project-visuals{min-width:0}.project-visuals-heading{margin-bottom:20px}.project-visuals-heading h3{font:25px/1.5 var(--serif)}.project-visuals-heading p{font-size:12px;line-height:1.95;margin-top:10px;max-width:700px}.project-visuals-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.project-visuals-grid.is-single{grid-template-columns:1fr}.project-visual{min-width:0;border:1px solid var(--line);background:var(--surface);border-radius:3px;overflow:hidden}.project-visual>button{position:relative;width:100%;display:block;overflow:hidden;background:#fff;padding:13px;aspect-ratio:1.35;min-height:210px}.project-visual>button:focus-visible{outline-offset:-5px}.project-visual img{display:block;object-fit:contain;width:100%;height:100%;transition:transform .2s}.project-visual>button:hover img{transform:scale(1.02)}.project-visual-zoom{position:absolute;right:12px;bottom:12px;padding:5px 10px;border-radius:2px;background:#28513f;color:#fdfcf8;font-size:9px;line-height:1.6}.project-visual figcaption{padding:18px 20px 20px;border-top:1px solid var(--line)}.project-visual-title{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.project-visual h4{font:19px/1.5 var(--serif)}.project-visual-title>span{flex-shrink:0;font-size:8px;color:var(--muted);border:1px solid var(--line);padding:2px 6px;border-radius:2px}.project-visual p{font-size:11px;line-height:1.9;margin-top:9px}.project-visual small{display:block;color:var(--muted);font-size:9px;line-height:1.85;margin-top:10px}.project-visuals-grid.is-single .project-visual>button{aspect-ratio:1.8;max-height:530px}
  @media(max-width:720px){.project-visuals-grid{grid-template-columns:1fr;gap:18px}.project-visuals-heading h3{font-size:23px}.project-visuals-heading p{font-size:11px}.project-visual>button,.project-visuals-grid.is-single .project-visual>button{aspect-ratio:auto;min-height:190px;max-height:450px;padding:10px}.project-visual img{height:auto;max-height:430px}.project-visual figcaption{padding:16px 17px 18px}.project-visual h4{font-size:19px}.project-visual p{font-size:10px}.project-visual small{font-size:9px}.project-visual-title{flex-wrap:wrap;gap:6px}}
  @media(prefers-reduced-motion:reduce){.project-visual img{transition:none}}
  .project-visual p{font-size:13px}.project-visual small{font-size:11px}.visual-data{border-top:1px solid var(--line);margin-top:15px;padding-top:12px}.visual-data summary{cursor:pointer;font-size:12px;color:var(--green);padding:4px 0}.visual-data table{border-collapse:collapse;width:100%;font-size:12px;margin-top:15px}.visual-data caption{text-align:left;color:var(--muted);padding-bottom:8px}.visual-data td,.visual-data th{padding:7px 0;border-bottom:1px solid var(--line);text-align:left;font-weight:400}.visual-data td{text-align:right;font-family:var(--mono)}.visual-data p{font-size:11px}.visual-data a{display:block;font-size:11px;text-decoration:underline;text-underline-offset:3px;margin-top:9px;overflow-wrap:anywhere}
</style>
